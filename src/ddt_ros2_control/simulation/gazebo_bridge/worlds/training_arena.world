<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="training_arena">
    <!-- Compact arena 16m x 12m; gaps >=2.0m for cloud inflation. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <remapping>model_states:=model_states</remapping>
        <remapping>link_states:=link_states</remapping>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="obstacle_50_2_12_wall_south_l">
      <static>true</static>
      <pose>0 -4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4 1.2</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

